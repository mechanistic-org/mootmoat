{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mootmoat",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "mootmoat.com/*",
      "zone_name": "mootmoat.com"
    },
    {
      "pattern": "www.mootmoat.com/*",
      "zone_name": "mootmoat.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/*"]
  },
  "r2_buckets": [
    {
      "binding": "MOOTMOAT_ASSETS",
      "bucket_name": "assets-mootmoat-com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
