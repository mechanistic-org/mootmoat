---
import Docs404Layout from "@/docs/layouts/Docs404Layout.astro";
import Button from "@/docs/components/button/Button.astro";
export const prerender = true;
---
<Docs404Layout title="Page not found | MootMoat" description="This page is unavailable. Return to the MootMoat method." noindex={true}>
  <main id="main-content" class="doctrine-landing" data-pagefind-ignore="all">
    <h1 class="docs-h1">Page not found.</h1>
    <p>This address has no published MootMoat page. The documentation index lists the current method and workbook.</p>
    <div class="doctrine-actions"><Button href="/docs/" variant="primary">Open the documentation</Button><Button href="/" variant="ghost">Return home</Button></div>
  </main>
</Docs404Layout>
