---
import { getDocs } from "@/docs/js/docsUtils";
import DocsLandingLayout from "@/docs/layouts/DocsLandingLayout.astro";
export const prerender = true;
export function getStaticPaths() { return [{ params: { docsRoute: "docs" } }]; }
const docs = await getDocs();
---
<DocsLandingLayout title="Start here | MootMoat" description="Choose a project, document one decision, and check what the evidence supports.">
  <main id="main-content" class="doctrine-landing" data-pagefind-body>
    <p class="doctrine-eyebrow" data-pagefind-ignore>The method / Contents</p>
    <h1 class="docs-h1">Start with one decision.</h1>
    <p>Choose a project you can discuss appropriately. Identify a decision you made, the constraint behind it, and the strongest available evidence. Use these pages to turn that material into a record a reader can examine.</p>
    <ol class="doctrine-index">
      {docs.map((doc) => <li><a href={`/docs/${doc.id}/`}>{doc.data.title}</a><p>{doc.data.description}</p></li>)}
    </ol>
    <p>Keep recollection, observation, inference, and proposal distinct. Publish only what the source and disclosure boundary support.</p>
  </main>
</DocsLandingLayout>
