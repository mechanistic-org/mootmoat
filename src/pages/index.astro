---
import DocsLandingLayout from "@/docs/layouts/DocsLandingLayout.astro";
import Button from "@/docs/components/button/Button.astro";
import siteData from "@/docs/config/siteData.json";
export const prerender = true;
---
<DocsLandingLayout title={siteData.title} description={siteData.description}>
  <main id="main-content" class="doctrine-landing" data-pagefind-body>
    <h1 class="docs-h1">Make the work reviewable.</h1>
    <p>MootMoat is a DIY method for documenting engineering experience: the constraint, the decision, your contribution, and the evidence behind it.</p>
    <p>You control the source record. A reader should be able to see what it supports and where it stops.</p>
    <div class="doctrine-actions">
      <Button href="/docs/workbook/" variant="primary">Start a workbook canvas</Button>
      <Button href="/docs/" variant="ghost">Read the method</Button>
    </div>
    <p>This is not an ATS bypass or an application-volume hack. It is a way to make specific claims easier to examine.</p>
  </main>
</DocsLandingLayout>
