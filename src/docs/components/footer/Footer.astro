---
import DocsLogo from "@/docs/components/docs-logo/DocsLogo.astro";
import SocialIconSimple from "@/docs/components/social/SocialIconSimple.astro";
import siteData from "@/docs/config/siteData.json";
import FooterLink from "./FooterLink.astro";
---
<footer class="bg-background text-foreground mt-8 border-t">
  <div class="docs-site-container pt-8 pb-16">
    <DocsLogo />
    <p class="mt-4">Author-controlled evidence. Specific claims. Visible limits.</p>
    <nav aria-label="Footer" class="mt-4 flex flex-wrap gap-4">
      <FooterLink href="/docs/">Start here</FooterLink>
      <FooterLink href="/docs/workbook/">Evidence workbook</FooterLink>
      <FooterLink href="/docs/faq/">FAQ</FooterLink>
      <FooterLink href="https://eriknorris.com/">Erik Norris / Portfolio</FooterLink>
      <FooterLink href="https://github.com/mechanistic-org/mootmoat" newTab>Repository</FooterLink>
      {siteData.footerSocials?.map((social) => <SocialIconSimple {...social} size="sm" />)}
    </nav>
    <p class="mt-4 text-sm">&copy; {new Date().getFullYear()} Erik Norris</p>
  </div>
</footer>
