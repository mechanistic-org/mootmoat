---
interface Props { link: string; text: string; }
const { link, text } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, "") === link.replace(/\/$/, "");
---
<li class="-ml-px flex flex-col gap-1">
  <a href={link} aria-current={current ? "page" : undefined} class:list={["docs-nav__link--sidebar docs-primary-focus py-0.5 pl-4 text-base md:text-sm", { "docs-nav__link--sidebar-current": current }]}>{text}</a>
</li>
