---
import { getDocs } from "@/docs/js/docsUtils";
import SidebarLink from "./SidebarLink.astro";
const docs = await getDocs();
---
<nav class="sidebar-nav space-y-8" aria-label="Documentation">
  <slot name="before-links" />
  <ul class="space-y-2 border-l">
    <SidebarLink link="/docs/" text="Start here" />
    {docs.map((doc) => <SidebarLink link={`/docs/${doc.id}/`} text={doc.data.title} />)}
  </ul>
  <slot name="after-links" />
</nav>
