{
  "name": "mootmoat",
  "type": "module",
  "version": "1.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:worker": "node ./scripts/build-cloudflare-worker.mjs",
    "deploy:worker": "npx --yes wrangler@4.114.0 deploy",
    "check:worker": "node ./scripts/check-worker-routing.mjs && npx --yes wrangler@4.114.0 deploy --dry-run",
    "deploy:production": "npx --yes wrangler@4.114.0 deploy --config wrangler.production.jsonc",
    "preview": "astro preview",
    "astro": "astro",
    "format": "eslint . --fix && prettier -w . --ignore-unknown --cache",
    "lint": "eslint .",
    "check:content": "node ./scripts/check-content.mjs",
    "search:dev": "node ./scripts/copy-search.mjs",
    "build:brand": "node ./scripts/build-brand.mjs",
    "check:design": "node ./scripts/check-design.mjs",
    "check:release-image": "node ./scripts/check-release-image.mjs",
    "check:production": "node ./scripts/check-production.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/mdx": "4.3.1",
    "@astrojs/sitemap": "3.4.1",
    "@expressive-code/plugin-line-numbers": "^0.41.3",
    "@fontsource-variable/geist": "5.2.6",
    "@pagefind/default-ui": "1.3.0",
    "@tabler/icons": "3.34.1",
    "@tailwindcss/vite": "4.1.11",
    "astro": "5.12.3",
    "astro-expressive-code": "0.41.3",
    "astro-icon": "1.1.5",
    "astro-seo": "0.8.4",
    "mime-types": "^3.0.2",
    "tailwind-variants": "1.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "1.3.6",
    "@fontsource-variable/jetbrains-mono": "5.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@playform/compress": "0.2.0",
    "eslint": "9.32.0",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.3",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "16.3.0",
    "pagefind": "1.3.0",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "typescript-eslint": "8.38.0",
    "sharp": "^0.33.0",
    "puppeteer": "24.35.0"
  },
  "overrides": {
    "sharp": "^0.33.0"
  }
}
